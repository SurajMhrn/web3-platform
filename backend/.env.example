# Server
PORT=5000
NODE_ENV=development
# Origin allowed by CORS and used for the Swagger UI examples. Must match
# where the frontend dev server actually runs.
FRONTEND_URL=http://localhost:5173

# Database (SQLite file, created automatically — see backend/README.md)
DB_USER=admin
DB_HOST=localhost
DB_NAME=web3_db
DB_PASSWORD=change-me
DB_PORT=5432

# Auth — REQUIRED. The server refuses to start without these. Generate real
# values with, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values — never reuse one secret for both tokens.
JWT_SECRET=replace-with-a-long-random-value-for-access-tokens
REFRESH_SECRET=replace-with-a-different-long-random-value-for-refresh-tokens

# Default admin account seeded on first run (only if no admin exists yet).
# If ADMIN_PASSWORD is left unset, a random one-time password is generated
# and printed to the server log instead.
ADMIN_EMAIL=admin@web3platform.com
ADMIN_PASSWORD=change-me
